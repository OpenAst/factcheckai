{
  "manifest_version": 3,
  "name": "SRT Fact-Check AI",
  "version": "1.0",
  "description": "AI-powered fact-checking assistant for SRT platform",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "tabCapture"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.threads.net/*",
    "https://*.intern.facebook.com/*",
    "https://*.our.intern.facebook.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.threads.net/*",
        "https://*.intern.facebook.com/*",
        "https://*.our.intern.facebook.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "capture_tools.js",
        "popup.js"
      ],
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.threads.net/*",
        "https://*.intern.facebook.com/*",
        "https://*.our.intern.facebook.com/*"
      ]
    }
  ]
}
